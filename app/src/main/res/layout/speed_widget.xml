<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:gravity="center_vertical"
 android:padding="12dp" android:background="@drawable/widget_panel">
 <TextView android:id="@+id/widget_title" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:text="SpeedVoice 0.9"
  android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold"/>
 <TextView android:id="@+id/widget_status" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:layout_marginTop="3dp"
  android:text="Stopped • tap Start" android:textColor="#FFDCE8F1"
  android:singleLine="true" android:ellipsize="end" android:textSize="12sp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="horizontal" android:layout_marginTop="10dp">
  <TextView android:id="@+id/widget_start" android:layout_width="0dp"
   android:layout_weight="1" android:layout_height="42dp" android:gravity="center"
   android:background="@drawable/widget_start" android:text="▶  START"
   android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="13sp"/>
  <TextView android:id="@+id/widget_stop" android:layout_width="0dp"
   android:layout_weight="1" android:layout_height="42dp" android:layout_marginStart="8dp"
   android:gravity="center" android:background="@drawable/widget_stop"
   android:text="■  STOP" android:textColor="#FFFFFFFF" android:textStyle="bold"
   android:textSize="13sp"/>
 </LinearLayout>
</LinearLayout>